# ─────────── Environment selection ───────────
# Copy this file to one of .env.local / .env.test / .env.prod.
# TEST_ENV picks which file is loaded (shared/env.ts):
#   TEST_ENV=local|test|prod  → loads exactly .env.<env> (errors if missing)
#   TEST_ENV unset            → first existing of .env.local → .env.test → .env.prod
# Example: TEST_ENV=test npx playwright test --project=wallet
#
# ─────────── Tester-wide ───────────
# Set to 0 to run headed Chromium (helpful for local debugging).
PWHEADLESS=1
# Number of retries on CI; set to 1 to debug locally.
PWRETRIES=0
# Override worker count; leave unset for Playwright default.
# PWWORKERS=2

# Test output / reporting knobs (consumed by shared/env.ts and reporter config).
TRACE=on-first-retry
SCREENSHOT=only-on-failure
VIDEO=off

# ─────────── warehouse ───────────
# Frontend dev URL (Vite). Leave blank if you only test the WebDAV/admin APIs.
WAREHOUSE_BASE_URL=http://localhost:5173
WAREHOUSE_ADMIN_URL=http://localhost:6066
WAREHOUSE_WEBDAV_URL=http://localhost:6065
WAREHOUSE_WEBDAV_PREFIX=/dav
WAREHOUSE_USER=admin
WAREHOUSE_PASS=changeme
WAREHOUSE_AUTH_TOKEN=

